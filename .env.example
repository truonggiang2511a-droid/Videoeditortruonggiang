# Server-side AI provider (KEEP SECRET)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# Supabase server-side values (KEEP secret except publishable key)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # only for trusted worker/admin jobs; never expose to browser
REQUIRE_AUTH=true

# Render infrastructure
RENDER_ENGINE=render-adapter
RENDER_WORKER_URL=
RENDER_WORKER_SECRET=

# Browser Supabase client (publishable key only)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional browser adapters (must be non-secret public endpoints)
VITE_AI_ENDPOINT=
VITE_VISION_ENDPOINT=
VITE_VOICE_ENDPOINT=

# Worker-only environment (set on the worker host, never in Vercel/browser)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# RENDER_WORKER_SECRET=
# STORAGE_BUCKET=ai-editor-assets
# FFMPEG_PRESET=veryfast
